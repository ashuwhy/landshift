			<element xmi:idref="EAID_0FF46DBF_16A2_47ec_9E9A_379EDA00FE90" xmi:type="uml:Note" scope="public">
				<model package="EAPK_FA80C1FF_20BB_45e9_9CD3_9E666418AAAA" tpos="0" ea_localid="40" ea_eleType="element"/>
				<properties documentation="Group 08: Ashutosh Sharma (23CS10005), Krishnkant Sahu (23CS10035), Sanskar Sovitkar (24CS10131)&#xA;&#xA;Source: Group 08 Assignment 1 QGIS project of Murakata and Sankrail (nine shapefile layers). Attribute names are the DBF field names. Enumeration values are the category values in each layer's QML style; ConstructionMaterial has no QML style, so its values come from the roads attribute table. The drainage shapefile has 0 features, so Drainage follows its field definition and QML style. The layers share no keys, so no feature-to-feature associations are modelled." isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="krish" version="1.0" phase="1.0" created="2026-10-30 18:06:22" modified="2026-10-30 18:09:22" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
