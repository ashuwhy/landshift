<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:uml="http://schema.omg.org/spec/UML/2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmi:version="2.1">
  <xmi:Documentation exporter="Enterprise Architect" exporterVersion="6.5"/>
  <uml:Model xmi:type="uml:Model" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="PKG_ROOT" name="Murakata Sankrail GIS Model" visibility="public">

      <!-- ============================================================ -->
      <!-- PACKAGE: Enumerations                                        -->
      <!-- ============================================================ -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_ENUM" name="Enumerations" visibility="public">

        <packagedElement xmi:type="uml:Enumeration" xmi:id="ENUM_BARELAND_TYPE" name="BarelandType" visibility="public">
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_BL_01" name="grassland"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_BL_02" name="barren"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_BL_03" name="scrubland"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_BL_04" name="sand"/>
        </packagedElement>

        <packagedElement xmi:type="uml:Enumeration" xmi:id="ENUM_DRAINAGE_TYPE" name="DrainageType" visibility="public">
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_DR_01" name="canal"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_DR_02" name="drain"/>
        </packagedElement>

        <packagedElement xmi:type="uml:Enumeration" xmi:id="ENUM_FOREST_TYPE" name="ForestType" visibility="public">
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_FT_01" name="tree_area"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_FT_02" name="tree_settlement"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_FT_03" name="tree_cropland"/>
        </packagedElement>

        <packagedElement xmi:type="uml:Enumeration" xmi:id="ENUM_LANDMARK_TYPE" name="LandmarkType" visibility="public">
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_01" name="temple"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_02" name="church"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_03" name="mosque"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_04" name="post_office"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_05" name="primary_school"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_06" name="high_school"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_07" name="grocery_shop"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_08" name="club"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_09" name="playground"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_10" name="ATM"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_11" name="bank"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_12" name="market"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_13" name="park"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_14" name="bridge"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_15" name="hotel"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_16" name="bus_stop"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_17" name="water_tank"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_18" name="electric_substation"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_19" name="rice_husking_shop"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_20" name="saw_mill"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_21" name="farm"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_22" name="ICDS"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_23" name="apartment_building"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_24" name="gym"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_25" name="swimming_pool"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_26" name="restaurant"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_27" name="studio"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_28" name="pond_ghat"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_29" name="cremation_ground"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_30" name="temple_tribal"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_31" name="firm"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_LM_32" name="shop"/>
        </packagedElement>

        <packagedElement xmi:type="uml:Enumeration" xmi:id="ENUM_SETTLEMENT_TYPE" name="SettlementType" visibility="public">
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_ST_01" name="residential"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_ST_02" name="commercial"/>
        </packagedElement>

        <packagedElement xmi:type="uml:Enumeration" xmi:id="ENUM_WATERBODY_TYPE" name="WaterbodyType" visibility="public">
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_WB_01" name="pond_settlement"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_WB_02" name="pond_cropland"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_WB_03" name="pond_forest"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_WB_04" name="lake"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_WB_05" name="river"/>
        </packagedElement>

        <packagedElement xmi:type="uml:Enumeration" xmi:id="ENUM_ROAD_TYPE" name="RoadType" visibility="public">
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_RT_01" name="highway"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_RT_02" name="inroad"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_RT_03" name="household_lane"/>
        </packagedElement>

        <packagedElement xmi:type="uml:Enumeration" xmi:id="ENUM_CONSTRUCTION" name="ConstructionMaterial" visibility="public">
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_CM_01" name="metal"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_CM_02" name="non_metal"/>
        </packagedElement>

        <packagedElement xmi:type="uml:Enumeration" xmi:id="ENUM_GEOM_TYPE" name="GeometryType" visibility="public">
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_GT_01" name="Point"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_GT_02" name="LineString"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EL_GT_03" name="Polygon"/>
        </packagedElement>

      </packagedElement>

      <!-- ============================================================ -->
      <!-- PACKAGE: GIS Project                                         -->
      <!-- ============================================================ -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_PROJECT" name="GIS Project" visibility="public">

        <!-- GISProject -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_GIS_PROJECT" name="GISProject" visibility="public">
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_GP_01" name="projectName" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_GP_02" name="version" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_GP_03" name="filePath" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
          </ownedAttribute>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_GP_01" name="loadProject" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_GP_01" name="filePath" direction="in">
              <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
            </ownedParameter>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_GP_02" name="saveProject" visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_GP_03" name="exportMap" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_GP_02" name="format" direction="in">
              <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
            </ownedParameter>
          </ownedOperation>
        </packagedElement>

        <!-- CoordinateReferenceSystem -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_CRS" name="CoordinateReferenceSystem" visibility="public">
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_CRS_01" name="epsgCode" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Integer"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_CRS_02" name="name" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_CRS_03" name="projection" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_CRS_04" name="datum" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_CRS_05" name="unit" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
          </ownedAttribute>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_CRS_01" name="transformTo" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_CRS_01" name="targetCRS" direction="in"/>
          </ownedOperation>
        </packagedElement>

        <!-- MapLayer -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_MAP_LAYER" name="MapLayer" visibility="public">
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_ML_01" name="layerName" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_ML_02" name="geometryType" visibility="public" type="ENUM_GEOM_TYPE"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_ML_03" name="rendererType" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_ML_04" name="visible" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Boolean"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_ML_05" name="opacity" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Real"/>
          </ownedAttribute>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ML_01" name="setSymbology" visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ML_02" name="getFeatureCount" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_ML_01" direction="return">
              <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Integer"/>
            </ownedParameter>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ML_03" name="applyFilter" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_ML_02" name="expression" direction="in">
              <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
            </ownedParameter>
          </ownedOperation>
        </packagedElement>

        <!-- Symbology -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_SYMBOLOGY" name="Symbology" visibility="public">
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_SY_01" name="fillColor" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_SY_02" name="strokeColor" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_SY_03" name="strokeWidth" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Real"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_SY_04" name="rendererType" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
          </ownedAttribute>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_SY_01" name="applyStyle" visibility="public"/>
        </packagedElement>

      </packagedElement>

      <!-- ============================================================ -->
      <!-- PACKAGE: Spatial Features                                    -->
      <!-- ============================================================ -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_FEATURES" name="Spatial Features" visibility="public">

        <!-- SpatialFeature (Abstract) -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_SPATIAL_FEATURE" name="SpatialFeature" visibility="public" isAbstract="true">
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_SF_01" name="id" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Integer"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_SF_02" name="geometryType" visibility="public" type="ENUM_GEOM_TYPE"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_SF_01" name="getGeometry" visibility="public" isAbstract="true"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_SF_02" name="getBoundingBox" visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_SF_03" name="intersects" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_SF_01" name="other" direction="in" type="CLS_SPATIAL_FEATURE"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_SF_02" direction="return">
              <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Boolean"/>
            </ownedParameter>
          </ownedOperation>
        </packagedElement>

        <!-- PolygonFeature (Abstract) -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_POLYGON_FEATURE" name="PolygonFeature" visibility="public" isAbstract="true">
          <generalization xmi:type="uml:Generalization" xmi:id="GEN_PF_SF" general="CLS_SPATIAL_FEATURE"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_PF_01" name="area" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Real"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_PF_02" name="perimeter" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Real"/>
          </ownedAttribute>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_PF_01" name="getArea" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_PF_01" direction="return">
              <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Real"/>
            </ownedParameter>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_PF_02" name="getPerimeter" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_PF_02" direction="return">
              <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Real"/>
            </ownedParameter>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_PF_03" name="contains" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_PF_03" name="point" direction="in" type="CLS_POINT_FEATURE"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_PF_04" direction="return">
              <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Boolean"/>
            </ownedParameter>
          </ownedOperation>
        </packagedElement>

        <!-- PointFeature (Abstract) -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_POINT_FEATURE" name="PointFeature" visibility="public" isAbstract="true">
          <generalization xmi:type="uml:Generalization" xmi:id="GEN_PT_SF" general="CLS_SPATIAL_FEATURE"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_PT_01" name="latitude" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Real"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_PT_02" name="longitude" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Real"/>
          </ownedAttribute>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_PT_01" name="distanceTo" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_PT_01" name="other" direction="in" type="CLS_POINT_FEATURE"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_PT_02" direction="return">
              <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Real"/>
            </ownedParameter>
          </ownedOperation>
        </packagedElement>

        <!-- LineFeature (Abstract) -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_LINE_FEATURE" name="LineFeature" visibility="public" isAbstract="true">
          <generalization xmi:type="uml:Generalization" xmi:id="GEN_LN_SF" general="CLS_SPATIAL_FEATURE"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_LN_01" name="length" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Real"/>
          </ownedAttribute>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_LN_01" name="getLength" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_LN_01" direction="return">
              <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Real"/>
            </ownedParameter>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_LN_02" name="getStartPoint" visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_LN_03" name="getEndPoint" visibility="public"/>
        </packagedElement>

        <!-- ==================== Concrete Feature Classes ==================== -->

        <!-- StudyArea (Boundary) -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_STUDY_AREA" name="StudyArea" visibility="public">
          <generalization xmi:type="uml:Generalization" xmi:id="GEN_SA_PF" general="CLS_POLYGON_FEATURE"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_SA_01" name="name" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_SA_02" name="totalArea" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Real"/>
          </ownedAttribute>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_SA_01" name="getTotalArea" visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_SA_02" name="containsFeature" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_SA_01" name="feature" direction="in" type="CLS_SPATIAL_FEATURE"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="PAR_SA_02" direction="return">
              <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#Boolean"/>
            </ownedParameter>
          </ownedOperation>
        </packagedElement>

        <!-- Bareland -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_BARELAND" name="Bareland" visibility="public">
          <generalization xmi:type="uml:Generalization" xmi:id="GEN_BL_PF" general="CLS_POLYGON_FEATURE"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_BL_01" name="barelandType" visibility="public" type="ENUM_BARELAND_TYPE"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_BL_01" name="getBarelandType" visibility="public"/>
        </packagedElement>

        <!-- Cropland -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_CROPLAND" name="Cropland" visibility="public">
          <generalization xmi:type="uml:Generalization" xmi:id="GEN_CL_PF" general="CLS_POLYGON_FEATURE"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_CL_01" name="cropType" visibility="public">
            <type xmi:type="uml:PrimitiveType" href="http://schema.omg.org/spec/UML/2.1/uml.xml#String"/>
          </ownedAttribute>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_CL_01" name="getCropType" visibility="public"/>
        </packagedElement>

        <!-- Drainage -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_DRAINAGE" name="Drainage" visibility="public">
          <generalization xmi:type="uml:Generalization" xmi:id="GEN_DR_PF" general="CLS_POLYGON_FEATURE"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_DR_01" name="drainageType" visibility="public" type="ENUM_DRAINAGE_TYPE"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_DR_01" name="getDrainageType" visibility="public"/>
        </packagedElement>

        <!-- Forest -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_FOREST" name="Forest" visibility="public">
          <generalization xmi:type="uml:Generalization" xmi:id="GEN_FR_PF" general="CLS_POLYGON_FEATURE"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_FR_01" name="forestType" visibility="public" type="ENUM_FOREST_TYPE"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_FR_01" name="getForestType" visibility="public"/>
        </packagedElement>

        <!-- Landmark -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_LANDMARK" name="Landmark" visibility="public">
          <generalization xmi:type="uml:Generalization" xmi:id="GEN_LK_PT" general="CLS_POINT_FEATURE"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_LK_01" name="landmarkType" visibility="public" type="ENUM_LANDMARK_TYPE"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_LK_01" name="getLandmarkType" visibility="public"/>
        </packagedElement>

        <!-- Settlement -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_SETTLEMENT" name="Settlement" visibility="public">
          <generalization xmi:type="uml:Generalization" xmi:id="GEN_SM_PF" general="CLS_POLYGON_FEATURE"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_SM_01" name="settlementType" visibility="public" type="ENUM_SETTLEMENT_TYPE"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_SM_01" name="getSettlementType" visibility="public"/>
        </packagedElement>

        <!-- Waterbody -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_WATERBODY" name="Waterbody" visibility="public">
          <generalization xmi:type="uml:Generalization" xmi:id="GEN_WB_PF" general="CLS_POLYGON_FEATURE"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_WB_01" name="waterbodyType" visibility="public" type="ENUM_WATERBODY_TYPE"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_WB_01" name="getWaterbodyType" visibility="public"/>
        </packagedElement>

        <!-- Road -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_ROAD" name="Road" visibility="public">
          <generalization xmi:type="uml:Generalization" xmi:id="GEN_RD_LN" general="CLS_LINE_FEATURE"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_RD_01" name="roadType" visibility="public" type="ENUM_ROAD_TYPE"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_RD_02" name="constructionMaterial" visibility="public" type="ENUM_CONSTRUCTION"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_RD_01" name="getRoadType" visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="OP_RD_02" name="getConstructionMaterial" visibility="public"/>
        </packagedElement>

      </packagedElement>

      <!-- ============================================================ -->
      <!-- ASSOCIATIONS                                                 -->
      <!-- ============================================================ -->

      <!-- GISProject uses CRS (1..1) -->
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_PROJECT_CRS" name="uses" visibility="public">
        <memberEnd xmi:idref="ASSOC_END_GP_CRS_1"/>
        <memberEnd xmi:idref="ASSOC_END_GP_CRS_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_GP_CRS_1" name="project" type="CLS_GIS_PROJECT" association="ASSOC_PROJECT_CRS">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_GP_CRS_1" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_GP_CRS_1" value="1"/>
        </ownedEnd>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_GP_CRS_2" name="crs" type="CLS_CRS" association="ASSOC_PROJECT_CRS">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_GP_CRS_2" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_GP_CRS_2" value="1"/>
        </ownedEnd>
      </packagedElement>

      <!-- GISProject contains MapLayers (1..*) — Composition -->
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_PROJECT_LAYER" name="contains" visibility="public">
        <memberEnd xmi:idref="ASSOC_END_GP_ML_1"/>
        <memberEnd xmi:idref="ASSOC_END_GP_ML_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_GP_ML_1" name="project" type="CLS_GIS_PROJECT" association="ASSOC_PROJECT_LAYER" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_GP_ML_1" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_GP_ML_1" value="1"/>
        </ownedEnd>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_GP_ML_2" name="layers" type="CLS_MAP_LAYER" association="ASSOC_PROJECT_LAYER">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_GP_ML_2" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_GP_ML_2" value="*"/>
        </ownedEnd>
      </packagedElement>

      <!-- GISProject defines StudyArea (1..1) — Composition -->
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_PROJECT_STUDYAREA" name="defines" visibility="public">
        <memberEnd xmi:idref="ASSOC_END_GP_SA_1"/>
        <memberEnd xmi:idref="ASSOC_END_GP_SA_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_GP_SA_1" name="project" type="CLS_GIS_PROJECT" association="ASSOC_PROJECT_STUDYAREA" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_GP_SA_1" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_GP_SA_1" value="1"/>
        </ownedEnd>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_GP_SA_2" name="studyArea" type="CLS_STUDY_AREA" association="ASSOC_PROJECT_STUDYAREA">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_GP_SA_2" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_GP_SA_2" value="1"/>
        </ownedEnd>
      </packagedElement>

      <!-- MapLayer displays SpatialFeatures (0..*) — Aggregation -->
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_LAYER_FEATURE" name="displays" visibility="public">
        <memberEnd xmi:idref="ASSOC_END_ML_SF_1"/>
        <memberEnd xmi:idref="ASSOC_END_ML_SF_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_ML_SF_1" name="layer" type="CLS_MAP_LAYER" association="ASSOC_LAYER_FEATURE" aggregation="shared">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_ML_SF_1" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_ML_SF_1" value="1"/>
        </ownedEnd>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_ML_SF_2" name="features" type="CLS_SPATIAL_FEATURE" association="ASSOC_LAYER_FEATURE">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_ML_SF_2" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_ML_SF_2" value="*"/>
        </ownedEnd>
      </packagedElement>

      <!-- MapLayer has Symbology (1..1) -->
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_LAYER_SYMBOLOGY" name="styledBy" visibility="public">
        <memberEnd xmi:idref="ASSOC_END_ML_SY_1"/>
        <memberEnd xmi:idref="ASSOC_END_ML_SY_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_ML_SY_1" name="layer" type="CLS_MAP_LAYER" association="ASSOC_LAYER_SYMBOLOGY">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_ML_SY_1" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_ML_SY_1" value="1"/>
        </ownedEnd>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_ML_SY_2" name="symbology" type="CLS_SYMBOLOGY" association="ASSOC_LAYER_SYMBOLOGY">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_ML_SY_2" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_ML_SY_2" value="1"/>
        </ownedEnd>
      </packagedElement>

      <!-- StudyArea contains SpatialFeatures (0..*) -->
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_STUDYAREA_FEATURES" name="encloses" visibility="public">
        <memberEnd xmi:idref="ASSOC_END_SA_SF_1"/>
        <memberEnd xmi:idref="ASSOC_END_SA_SF_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_SA_SF_1" name="studyArea" type="CLS_STUDY_AREA" association="ASSOC_STUDYAREA_FEATURES">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_SA_SF_1" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_SA_SF_1" value="1"/>
        </ownedEnd>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_SA_SF_2" name="features" type="CLS_SPATIAL_FEATURE" association="ASSOC_STUDYAREA_FEATURES">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_SA_SF_2" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_SA_SF_2" value="*"/>
        </ownedEnd>
      </packagedElement>

      <!-- Landmark locatedIn Settlement (0..1) -->
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_LANDMARK_SETTLEMENT" name="locatedIn" visibility="public">
        <memberEnd xmi:idref="ASSOC_END_LK_SM_1"/>
        <memberEnd xmi:idref="ASSOC_END_LK_SM_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_LK_SM_1" name="landmarks" type="CLS_LANDMARK" association="ASSOC_LANDMARK_SETTLEMENT">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_LK_SM_1" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_LK_SM_1" value="*"/>
        </ownedEnd>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_LK_SM_2" name="settlement" type="CLS_SETTLEMENT" association="ASSOC_LANDMARK_SETTLEMENT">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_LK_SM_2" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_LK_SM_2" value="1"/>
        </ownedEnd>
      </packagedElement>

      <!-- Road connects Settlement (0..*) -->
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_ROAD_SETTLEMENT" name="connects" visibility="public">
        <memberEnd xmi:idref="ASSOC_END_RD_SM_1"/>
        <memberEnd xmi:idref="ASSOC_END_RD_SM_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_RD_SM_1" name="roads" type="CLS_ROAD" association="ASSOC_ROAD_SETTLEMENT">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_RD_SM_1" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_RD_SM_1" value="*"/>
        </ownedEnd>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_RD_SM_2" name="settlements" type="CLS_SETTLEMENT" association="ASSOC_ROAD_SETTLEMENT">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_RD_SM_2" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_RD_SM_2" value="*"/>
        </ownedEnd>
      </packagedElement>

      <!-- Drainage drains into Waterbody (0..*) -->
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_DRAINAGE_WATERBODY" name="drainsInto" visibility="public">
        <memberEnd xmi:idref="ASSOC_END_DR_WB_1"/>
        <memberEnd xmi:idref="ASSOC_END_DR_WB_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_DR_WB_1" name="drainage" type="CLS_DRAINAGE" association="ASSOC_DRAINAGE_WATERBODY">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_DR_WB_1" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_DR_WB_1" value="*"/>
        </ownedEnd>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_DR_WB_2" name="waterbodies" type="CLS_WATERBODY" association="ASSOC_DRAINAGE_WATERBODY">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_DR_WB_2" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_DR_WB_2" value="*"/>
        </ownedEnd>
      </packagedElement>

      <!-- Forest adjacentTo Cropland (0..*) -->
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_FOREST_CROPLAND" name="adjacentTo" visibility="public">
        <memberEnd xmi:idref="ASSOC_END_FR_CL_1"/>
        <memberEnd xmi:idref="ASSOC_END_FR_CL_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_FR_CL_1" name="forests" type="CLS_FOREST" association="ASSOC_FOREST_CROPLAND">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_FR_CL_1" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_FR_CL_1" value="*"/>
        </ownedEnd>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_END_FR_CL_2" name="croplands" type="CLS_CROPLAND" association="ASSOC_FOREST_CROPLAND">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_FR_CL_2" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_FR_CL_2" value="*"/>
        </ownedEnd>
      </packagedElement>

    </packagedElement>
  </uml:Model>
</xmi:XMI>

